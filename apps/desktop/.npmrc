# Supply-chain gate for npm (the counterpart of deny.toml on the Rust side).
#
# Lifecycle scripts (preinstall/install/postinstall/prepare) of dependencies
# are the main way compromised npm packages get in: they run at install time
# with the developer's privileges, before any code is built or executed.
# Hence: off globally.
#
# As of 2026-08-31, EXACTLY ONE package in the whole lockfile has an install
# script, and it does not need it:
#   - fsevents (dev)     install: node-gyp rebuild — macOS-only and optional,
#                        not even installed on Windows/Linux.
#
# esbuild used to be the second one; Vite 8 builds through Rolldown and no
# longer pulls it in at all.
#
# So there is currently NO exception. Should a package stop working without
# its install script in the future, do NOT water down this file; unlock that
# one package specifically and justify it here:
#   npm rebuild <package> --ignore-scripts=false --foreground-scripts
#
# The scripts in package.json (dev/build/test/...) are NOT affected —
# ignore-scripts only applies to lifecycle scripts at install time.
ignore-scripts=true

# No silent access to foreign registries: everything comes from the npm registry
# recorded in the lockfile.
registry=https://registry.npmjs.org/
